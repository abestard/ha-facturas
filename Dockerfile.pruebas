# Entorno de pruebas: Python 3.13 y Home Assistant Core 2025.11.3 (la versión instalada).
# HA no se puede instalar en Windows, así que las pruebas corren en Linux con Docker:
#   docker build -f Dockerfile.pruebas -t ha-facturas-pruebas .
#   docker run --rm -v "$PWD:/repo" ha-facturas-pruebas
# Imagen completa (no slim): lru-dict, dependencia de HA, se compila y necesita gcc.
FROM python:3.13
RUN pip install --no-cache-dir uv
COPY requirements_test.txt /tmp/
RUN uv pip install --system --no-cache -r /tmp/requirements_test.txt
WORKDIR /repo
CMD ["pytest"]
